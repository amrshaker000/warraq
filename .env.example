# متغيرات البيئة لتطبيق إدارة أعضاء الحزب

# عنوان الخادم الخلفي
VITE_API_URL=http://localhost:5000/api

# إعدادات التطبيق
VITE_APP_NAME="نظام إدارة أعضاء الحزب"
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="نظام شامل لإدارة بيانات أعضاء الحزب"

# إعدادات الأمان
VITE_SESSION_TIMEOUT=3600000
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOCKOUT_DURATION=900000

# إعدادات الملفات
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=".jpg,.jpeg,.png,.pdf,.csv,.xlsx"

# إعدادات قاعدة البيانات
VITE_DB_PATH=./data/members.db
VITE_DB_BACKUP_PATH=./data/backups/

# إعدادات النسخ الاحتياطي
VITE_BACKUP_ENABLED=true
VITE_BACKUP_FREQUENCY=daily
VITE_BACKUP_RETENTION_DAYS=30

# إعدادات التحليلات
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=

# إعدادات الإشعارات
VITE_NOTIFICATIONS_ENABLED=true
VITE_NOTIFICATION_SOUND=true
VITE_NOTIFICATION_DESKTOP=true

# إعدادات السمة واللغة
VITE_DEFAULT_THEME=auto
VITE_DEFAULT_LANGUAGE=ar

# إعدادات التطوير
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info

# إعدادات الأداء
VITE_CACHE_ENABLED=true
VITE_CACHE_DURATION=300000
VITE_LAZY_LOAD_THRESHOLD=10

# إعدادات التصدير
VITE_EXPORT_CHUNK_SIZE=1000
VITE_EXPORT_TIMEOUT=30000

# إعدادات الاستيراد
VITE_IMPORT_BATCH_SIZE=100
VITE_IMPORT_VALIDATION=true
VITE_IMPORT_ALLOW_DUPLICATES=false

# إعدادات البريد الإلكتروني (اختيارية)
VITE_SMTP_HOST=
VITE_SMTP_PORT=587
VITE_SMTP_USER=
VITE_SMTP_PASS=
VITE_EMAIL_FROM=

# إعدادات التخزين السحابي (اختيارية)
VITE_CLOUD_STORAGE_PROVIDER=
VITE_CLOUD_BUCKET=
VITE_CLOUD_REGION=

# مفاتيح API (يجب إضافتها في بيئة الإنتاج فقط)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
# VITE_STRIPE_PUBLISHABLE_KEY=
